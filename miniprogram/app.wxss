/* 全局样式 */
page {
  background: #f5f6f8;
  font-size: 28rpx;
  color: #222;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC",
    "Microsoft YaHei", sans-serif;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: #1a1a1a;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 180rpx;
  color: #666;
  flex-shrink: 0;
}

.form-value {
  flex: 1;
  min-width: 0;
}

.picker-value {
  color: #222;
}

.picker-placeholder {
  color: #bbb;
}

.input {
  width: 100%;
  height: 60rpx;
  line-height: 60rpx;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  line-height: 1.5;
  padding: 12rpx 0;
}

.btn-primary {
  background: #166d43;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 16rpx;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  background: #a8c8b8 !important;
  color: #fff !important;
}

.btn-ghost {
  background: #fff;
  color: #166d43;
  border: 2rpx solid #166d43;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 16rpx;
}

.btn-ghost::after {
  border: none;
}

.tag-admin {
  display: inline-block;
  background: #ff9f0a;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  margin-left: 12rpx;
  vertical-align: middle;
}

.tag-debug {
  display: inline-block;
  background: #eee;
  color: #888;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  margin-left: 12rpx;
  vertical-align: middle;
}

.empty {
  text-align: center;
  color: #aaa;
  padding: 48rpx 0;
  font-size: 26rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #444;
  margin: 24rpx 0 16rpx;
}
