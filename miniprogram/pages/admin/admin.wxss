.admin-banner {
  background: #fff8e8;
  border: 2rpx solid #ffd591;
  color: #ad6800;
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 16rpx;
}

.tab-active {
  background: #166d43;
  color: #fff;
  font-weight: 600;
}

.add-card {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
}

.add-input {
  flex: 1;
  height: 68rpx;
  background: #f5f6f8;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}

.add-btn {
  margin-left: 16rpx;
  background: #166d43;
  color: #fff;
  font-size: 26rpx;
  border-radius: 12rpx;
  padding: 0 32rpx;
  line-height: 68rpx;
  height: 68rpx;
}

.add-btn::after {
  border: none;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.list-item:last-child {
  border-bottom: none;
}

.list-name {
  font-size: 28rpx;
  font-weight: 500;
}

.list-del {
  color: #e74c3c;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border: 2rpx solid #f0c2bc;
  border-radius: 10rpx;
}
